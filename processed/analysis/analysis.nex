BEGIN SETS;
    CHARSET tRNA-Phe = 1-69;
    CHARSET s-rRNA = 70-1024;
    CHARSET tRNA-Val = 1025-1091;
    CHARSET l-rRNA = 1092-2676;
    CHARSET tRNA-Leu_UUR = 2677-2751;
    CHARSET tRNA-Leu_UUR_UAR_gene_ND1 = 2752-2753;
    CHARSET gene_ND1 = 2754-3710;
    CHARSET tRNA-Ile = 3710-3778;
    CHARSET tRNA-Gln = 3775-3849;
    CHARSET tRNA-Gln_UAR_tRNA-Met = 3850-3850;
    CHARSET tRNA-Met = 3851-3920;
    CHARSET gene_ND2 = 3921-4964;
    CHARSET tRNA-Trp = 4963-5030;
    CHARSET tRNA-Trp_UAR_tRNA-Ala = 5031-5043;
    CHARSET tRNA-Ala = 5044-5112;
    CHARSET tRNA-Ala_UAR_tRNA-Asn = 5113-5113;
    CHARSET tRNA-Asn = 5114-5185;
    CHARSET origin_of_replication = 5186-5223;
    CHARSET tRNA-Cys = 5220-5287;
    CHARSET tRNA-Tyr = 5288-5355;
    CHARSET tRNA-Tyr_UAR_gene_COX1 = 5356-5356;
    CHARSET gene_COX1 = 5357-6901;
    CHARSET tRNA-Ser_UCN = 6899-6969;
    CHARSET tRNA-Ser_UCN_UAR_tRNA-Asp = 6970-6973;
    CHARSET tRNA-Asp = 6974-7041;
    CHARSET gene_COX2 = 7042-7725;
    CHARSET gene_COX2_UAR_tRNA-Lys = 7726-7742;
    CHARSET tRNA-Lys = 7743-7809;
    CHARSET tRNA-Lys_UAR_gene_ATP8 = 7810-7810;
    CHARSET gene_ATP8 = 7811-8014;
    CHARSET gene_ATP6 = 7972-8652;
    CHARSET gene_COX3 = 8652-9435;
    CHARSET tRNA-Gly = 9436-9503;
    CHARSET gene_ND3 = 9504-9850;
    CHARSET tRNA-Arg = 9850-9919;
    CHARSET tRNA-Arg_UAR_gene_ND4L = 9920-9921;
    CHARSET gene_ND4L = 9922-10218;
    CHARSET gene_ND4 = 10212-11589;
    CHARSET tRNA-His = 11588-11658;
    CHARSET tRNA-Ser_AGY = 11659-11718;
    CHARSET tRNA-Leu_CUN = 11719-11788;
    CHARSET gene_ND5 = 11789-13609;
    CHARSET gene_ND6 = 13593-14120;
    CHARSET tRNA-Glu = 14119-14189;
    CHARSET tRNA-Glu_UAR_gene_CYTB = 14190-14193;
    CHARSET gene_CYTB = 14194-15333;
    CHARSET tRNA-Thr = 15334-15403;
    CHARSET tRNA-Pro = 15403-15468;
    CHARSET D_loop = 15469-16796;
    CHARSET D_loop_UAR = 16797-16850;
END;

BEGIN MRBAYES;

    set autoclose=yes;
    lset nst=6 rates=gamma;
    partition mtDNA = 50: tRNA-Phe, s-rRNA, tRNA-Val, l-rRNA, tRNA-Leu_UUR, tRNA-Leu_UUR_UAR_gene_ND1, gene_ND1, tRNA-Ile, tRNA-Gln, tRNA-Gln_UAR_tRNA-Met, tRNA-Met, gene_ND2, tRNA-Trp, tRNA-Trp_UAR_tRNA-Ala, tRNA-Ala, tRNA-Ala_UAR_tRNA-Asn, tRNA-Asn, origin_of_replication, tRNA-Cys, tRNA-Tyr, tRNA-Tyr_UAR_gene_COX1, gene_COX1, tRNA-Ser_UCN, tRNA-Ser_UCN_UAR_tRNA-Asp, tRNA-Asp, gene_COX2, gene_COX2_UAR_tRNA-Lys, tRNA-Lys, tRNA-Lys_UAR_gene_ATP8, gene_ATP8, gene_ATP6, gene_COX3, tRNA-Gly, gene_ND3, tRNA-Arg, tRNA-Arg_UAR_gene_ND4L, gene_ND4L, gene_ND4, tRNA-His, tRNA-Ser_AGY, tRNA-Leu_CUN, gene_ND5, gene_ND6, tRNA-Glu, tRNA-Glu_UAR_gene_CYTB, gene_CYTB, tRNA-Thr, tRNA-Pro, D_loop, D_loop_UAR;
    set partition=mtDNA;
    unlink statefreq=(all) revmat=(all) shape=(all) pinvar=(all);
    prset ratepr=variable;
    mcmcp ngen=1000000 samplefreq=1000 nchains=4 savebrlens=yes;
    mcmc;
    sump burnin=250000;
    sumt burnin=250000;
END;
